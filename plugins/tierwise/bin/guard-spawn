#!/usr/bin/env python3
"""tierwise's subagent hooks (stdin: hook JSON).

  guard-spawn pre-agent | pre-write | pre-bash | pre-handback | subagent-stop
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from mlib import guard  # noqa: E402
from mlib.common import emit, hook_input  # noqa: E402

HANDLERS = {"pre-agent": guard.pre_agent, "pre-write": guard.pre_write, "pre-bash": guard.pre_bash,
            "pre-handback": guard.pre_handback, "subagent-stop": guard.subagent_stop}


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in HANDLERS:
        print(__doc__, file=sys.stderr)
        return 2
    out = HANDLERS[sys.argv[1]](hook_input())
    if out:
        emit(out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
