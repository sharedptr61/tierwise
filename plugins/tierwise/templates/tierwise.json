  "checks": {
    "unit": null,
    "typecheck": null,
    "lint": null,
    "docs": null,
    "race": null,
    "sast": null,
    "sca": null,
    "iac": null,
    "migration": null,
    "mutation": null,
    "secrets": "builtin",
