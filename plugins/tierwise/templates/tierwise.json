{
  "confirmed": false,
  "planner": {
    "effort": "xhigh",
    "effortR3": "max",
    "replanEffort": "max",
    "fallbackModel": "opus",
    "planClasses": [
      "feature",
      "bulk",
      "investigation",
      "high-risk"
    ]
  },
  "classifier": {
    "useModel": true,
    "model": "haiku",
    "underspecifiedWords": 8
  },
  "caps": {
    "routesPerUnit": 3,
    "replansPerTask": 1,
    "principalCallsPerTask": 2,
    "parallelBuilders": 3,
    "gateBlocksPerTask": 8,
    "checkTimeoutSeconds": 300,
    "taskBudgetUsd": 25,
    "fableWeeklyOutputTokensWarn": 1500000
  },
  "risk": {
    "R3": [
      "**/auth/**",
      "**/authn/**",
      "**/authz/**",
      "**/login/**",
      "**/session/**",
      "**/sessions/**",
      "**/security/**",
      "**/crypto/**",
      "**/*crypt*",
      "**/payment*/**",
      "**/billing/**",
      "**/checkout/**",
      "**/migrations/**",
      "**/migrate/**",
      "**/*.sql",
      "**/terraform/**",
      "**/*.tf",
      "**/*.tfvars",
      "**/k8s/**",
      "**/kubernetes/**",
      "**/helm/**",
      "**/deploy/**",
      "**/infra/**",
      "**/Dockerfile*",
      "**/docker-compose*.yml",
      "**/.github/workflows/**",
      "**/.gitlab-ci.yml",
      "**/secrets/**",
      "**/.env*",
      "**/pii/**",
      "**/personal*/**"
